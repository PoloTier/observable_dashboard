<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Molecule 3D Viewer</title>
  <script src="assets/vendor/3Dmol-min.js?v={{ static_version }}"></script>
  <script src="assets/vendor/plotly-2.35.2.min.js?v={{ static_version }}"></script>
  <script src="assets/vendor/gif.min.js?v={{ static_version }}"></script>
  <style>
    :root {
      --bg: #f7f8fa;
      --panel: #ffffff;
      --border: #d7dce3;
      --text: #1f2937;
      --muted: #6b7280;
      --accent: #0b5ed7;
    }
    body {
      margin: 0;
      font-family: "Segoe UI", "Helvetica Neue", sans-serif;
      background: var(--bg);
      color: var(--text);
    }
    .page {
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 16px;
      box-sizing: border-box;
    }
    .header,
    .viewer-card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 12px;
    }
    .header {
      padding: 12px 14px;
      margin-bottom: 12px;
    }
    .title {
      font-size: 20px;
      font-weight: 600;
      margin-bottom: 8px;
    }
    .controls {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
    }
    #controls-primary {
      margin-bottom: 8px;
    }
    #controls-groups {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .control-group {
      border: 1px solid #d9dee7;
      border-radius: 10px;
      background: #f8fafc;
      overflow: hidden;
    }
    .control-group > summary {
      list-style: none;
      cursor: pointer;
      user-select: none;
      color: #374151;
      font-size: 12px;
      font-weight: 600;
      padding: 7px 10px;
      background: #f3f6fa;
      border-bottom: 1px solid transparent;
    }
    .control-group > summary::-webkit-details-marker {
      display: none;
    }
    .control-group[open] > summary {
      border-bottom-color: #d9dee7;
    }
    .control-group-body {
      padding: 8px 10px;
    }
    .controls label {
      font-size: 13px;
      color: var(--muted);
    }
    .controls .check-label {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      user-select: none;
    }
    .controls select,
    .controls button,
    .controls input {
      font-size: 13px;
      border: 1px solid #cdd4df;
      border-radius: 6px;
      padding: 5px 8px;
      background: #fff;
    }
    .controls button {
      cursor: pointer;
    }
    .controls button.active {
      background: var(--accent);
      color: #fff;
      border-color: var(--accent);
    }
    #playback-rate-slider,
    #playback-stride-slider,
    #nac-scale-slider,
    #de-scale-slider,
    #de-nac-scale-slider,
    #atom-size-slider,
    #bond-radius-slider {
      width: clamp(110px, 18vw, 160px);
      min-width: 96px;
      padding: 0;
      border: 0;
      background: transparent;
      accent-color: var(--accent);
    }
    #playback-rate-label,
    #playback-stride-label,
    #nac-scale-label,
    #de-scale-label,
    #de-nac-scale-label,
    #atom-size-label,
    #bond-radius-label {
      font-size: 12px;
      color: var(--muted);
      min-width: 32px;
      text-align: right;
      white-space: nowrap;
    }
    .atom-style-controls {
      width: 100%;
      margin-top: 6px;
      padding-top: 6px;
      border-top: 1px dashed #d9dee7;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
    }
    #atom-style-range-input {
      min-width: 220px;
      flex: 1 1 280px;
    }
    #atom-style-mode-select {
      min-width: 110px;
    }
    #atom-style-add-btn {
      border: 1px solid #b7c8ea;
      color: #0b5ed7;
      background: #eef5ff;
      font-weight: 600;
      line-height: 1.1;
      padding: 4px 8px;
    }
    #atom-style-add-btn:hover:not(:disabled) {
      background: #dceaff;
    }
    #atom-style-clear-btn {
      border: 1px solid #efc5c1;
      color: #b42318;
      background: #fff7f6;
      line-height: 1.1;
      padding: 4px 8px;
    }
    #atom-style-clear-btn:hover:not(:disabled) {
      background: #ffe9e7;
    }
    #atom-style-rules-hint {
      width: 100%;
      color: #64748b;
    }
    .atom-style-rules {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .atom-style-rule-row {
      display: flex;
      align-items: center;
      gap: 8px;
      border: 1px solid #d8dee8;
      border-left: 4px solid #0b5ed7;
      border-radius: 8px;
      background: #fff;
      padding: 4px 6px;
    }
    .atom-style-rule-mode {
      display: inline-flex;
      align-items: center;
      border: 1px solid #c7d6ef;
      border-radius: 999px;
      background: #eef5ff;
      color: #0b5ed7;
      font-size: 11px;
      font-weight: 600;
      line-height: 1;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      padding: 3px 7px;
      white-space: nowrap;
    }
    .atom-style-rule-spec {
      flex: 1 1 auto;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: 12px;
      color: #334155;
      overflow-wrap: anywhere;
    }
    .atom-style-rule-remove-btn {
      border: 1px solid #efc5c1;
      color: #b42318;
      background: #fff7f6;
      line-height: 1.1;
      padding: 3px 8px;
    }
    .atom-style-rule-remove-btn:hover:not(:disabled) {
      background: #ffe9e7;
    }
    .atom-style-rule-empty {
      color: var(--muted);
      font-size: 12px;
      padding: 4px 2px;
    }
    .de-pair-rows {
      display: flex;
      flex-direction: column;
      gap: 6px;
      width: 100%;
    }
    .de-pair-row {
      display: grid;
      grid-template-columns: 14px auto auto minmax(56px, 80px) auto minmax(56px, 80px) auto;
      align-items: center;
      gap: 6px;
      border: 1px solid #d9dee7;
      border-radius: 8px;
      background: #fff;
      padding: 6px 8px;
    }
    .de-pair-row.disabled {
      opacity: 0.6;
    }
    .de-row-swatch {
      width: 12px;
      height: 12px;
      border-radius: 999px;
      border: 1px solid rgba(17, 24, 39, 0.24);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.4);
      justify-self: center;
      align-self: center;
      background: #6b7280;
    }
    .de-row-label {
      font-size: 12px;
      color: #64748b;
    }
    #de-visual-hint {
      width: 100%;
      color: #64748b;
    }
    .de-row-remove-btn {
      justify-self: end;
      border: 1px solid #efc5c1;
      color: #b42318;
      background: #fff7f6;
      padding: 4px 8px;
      line-height: 1.1;
    }
    .de-row-remove-btn:hover:not(:disabled) {
      background: #ffe9e7;
    }
    .de-pair-actions {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    #add-de-pair-btn {
      border: 1px solid #b7c8ea;
      color: #0b5ed7;
      background: #eef5ff;
      font-weight: 600;
      line-height: 1.1;
      padding: 4px 8px;
    }
    #add-de-pair-btn:hover:not(:disabled) {
      background: #dceaff;
    }
    #add-de-pair-btn:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }
    @media (max-width: 760px) {
      .de-pair-row {
        grid-template-columns: 14px auto auto 1fr;
        grid-auto-rows: minmax(0, auto);
      }
      .de-row-label {
        justify-self: end;
      }
      .de-row-remove-btn {
        grid-column: 1 / -1;
        justify-self: start;
      }
    }
    #gif-export-start,
    #gif-export-end {
      width: 74px;
      padding: 4px 6px;
    }
    #gif-export-progress {
      font-size: 12px;
      color: var(--muted);
      white-space: nowrap;
      min-width: 110px;
    }
    .bond-selection-info {
      font-size: 12px;
      color: var(--muted);
      white-space: nowrap;
    }
    .source-pkl {
      font-size: 12px;
      color: var(--muted);
      margin-top: 8px;
      max-width: 100%;
      overflow: hidden;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
    .viewer-card {
      padding: 12px;
      max-width: none;
      margin: 0;
      overflow: hidden;
    }
    #viewer {
      width: 100%;
      min-width: 320px;
      max-width: 100%;
      height: clamp(280px, 46vh, 460px);
      min-height: 280px;
      max-height: 85vh;
      border: 1px solid #d9dee7;
      border-radius: 10px;
      position: relative;
      display: block;
      overflow: hidden;
      resize: both;
      contain: layout paint;
      isolation: isolate;
      background: #fff;
    }
    .status-row {
      margin-top: 8px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .status {
      font-size: 12px;
      color: var(--muted);
      min-height: 18px;
      flex: 1 1 auto;
    }
    .status-tool-btn {
      border: 1px solid #cdd4df;
      border-radius: 6px;
      background: #fff;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.1;
      padding: 4px 8px;
      cursor: pointer;
      white-space: nowrap;
    }
    .status-tool-btn:hover:not(:disabled) {
      background: #f2f6fb;
      color: var(--text);
    }
    .status-tool-btn.active {
      border-color: var(--accent);
      color: var(--accent);
      background: #eef5ff;
    }
    .status-tool-btn:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }
    .status.error {
      color: #c0392b;
    }
    .bond-color-settings-panel {
      margin-top: 8px;
      border: 1px solid #d9dee7;
      border-radius: 10px;
      background: #f8fafc;
      padding: 8px;
    }
    .bond-color-settings-panel[hidden] {
      display: none;
    }
    .bond-color-settings-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px;
    }
    .bond-color-settings-title {
      font-size: 12px;
      color: #374151;
      font-weight: 600;
    }
    .bond-color-settings-close {
      border: 1px solid #cdd4df;
      border-radius: 6px;
      background: #fff;
      color: #4b5563;
      cursor: pointer;
      font-size: 12px;
      line-height: 1;
      padding: 3px 7px;
    }
    .bond-color-settings-list {
      display: flex;
      flex-direction: column;
      gap: 6px;
      max-height: 180px;
      overflow-y: auto;
    }
    .bond-color-row {
      display: flex;
      align-items: center;
      gap: 8px;
      border: 1px solid #d8dee8;
      border-left: 4px solid #1f77b4;
      border-radius: 8px;
      background: #fff;
      padding: 4px 6px;
    }
    .bond-color-swatch {
      width: 12px;
      height: 12px;
      border-radius: 3px;
      border: 1px solid rgba(0, 0, 0, 0.16);
      flex: 0 0 auto;
    }
    .bond-color-label {
      font-size: 12px;
      color: #374151;
      flex: 1 1 auto;
    }
    .bond-color-input {
      width: 34px;
      height: 24px;
      border: none;
      background: transparent;
      padding: 0;
      cursor: pointer;
      flex: 0 0 auto;
    }
    .bond-color-empty {
      color: var(--muted);
      font-size: 12px;
      padding: 4px 2px;
    }
    .bond-list {
      margin-top: 10px;
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      min-height: 32px;
      align-items: center;
    }
    .bond-list-empty {
      color: var(--muted);
      font-size: 12px;
    }
    .bond-item {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: 1px solid #d1d8e3;
      border-left: 4px solid #1f77b4;
      border-radius: 8px;
      padding: 2px 6px;
      background: #fff;
    }
    .bond-item.active {
      background: #eef5ff;
      border-color: #8db5ff;
    }
    .bond-activate,
    .bond-remove {
      border: 1px solid #cdd4df;
      border-radius: 6px;
      background: #fff;
      font-size: 12px;
      padding: 3px 8px;
      cursor: pointer;
      line-height: 1.1;
    }
    .bond-activate:hover,
    .bond-remove:hover {
      background: #f2f6fb;
    }
    .bond-remove {
      font-weight: 700;
      padding: 3px 6px;
      color: #b42318;
      border-color: #f1c2bd;
      background: #fff7f6;
    }
    #bond-plot {
      margin-top: 10px;
      width: 100%;
      height: 220px;
      border: 1px solid #d9dee7;
      border-radius: 10px;
      background: #fff;
      overflow: hidden;
    }
    .bond-plot-empty {
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--muted);
      font-size: 13px;
      text-align: center;
      padding: 0 12px;
      box-sizing: border-box;
    }
  </style>
</head>
<body>
  <div class="page">
    <div class="header">
      <div class="title">Molecule 3D Trajectory Viewer</div>
      <div class="controls" id="controls-primary">
        <label for="traj-select">Trajectory</label>
        <select id="traj-select"></select>

        <button id="play-btn" type="button">Play</button>

        <label for="frame-slider">Frame</label>
        <input id="frame-slider" type="range" min="0" max="0" step="1" value="0" />
        <span id="frame-label">Frame 1/1</span>

        <button id="export-gif-btn" type="button" disabled>Export GIF</button>
        <button id="export-video-btn" type="button" disabled>Export Video</button>
      </div>

      <div id="controls-groups">
        <details id="measure-controls-group" class="control-group">
          <summary>Measure & Export</summary>
          <div class="controls control-group-body">
            <label class="check-label" for="show-atom-index">
              <input id="show-atom-index" type="checkbox" />
              Atom Indices
            </label>

            <label>Measure</label>
            <button id="measure-type-bond-btn" type="button" class="active">Bond</button>
            <button id="measure-type-angle-btn" type="button">Angle</button>
            <button id="measure-type-dihedral-btn" type="button">Dihedral</button>

            <button id="select-bond-btn" type="button">Select Bond</button>
            <button id="clear-bond-btn" type="button" disabled>Clear Bond</button>
            <span class="bond-selection-info" id="bond-selection-info">Bonds: none</span>

            <button id="save-frame-xyz-btn" type="button" disabled>Save Frame XYZ</button>
            <button id="save-traj-xyz-btn" type="button" disabled>Save Trajectory XYZ</button>
          </div>
        </details>

        <details id="playback-controls-group" class="control-group">
          <summary>Playback</summary>
          <div class="controls control-group-body">
            <label for="playback-rate-slider">Speed</label>
            <input id="playback-rate-slider" type="range" min="1" max="10" step="0.5" value="1" />
            <span id="playback-rate-label">1.0x</span>

            <label for="playback-stride-slider">Stride</label>
            <input id="playback-stride-slider" type="range" min="1" max="20" step="1" value="1" />
            <span id="playback-stride-label">x1</span>
          </div>
        </details>

        <details id="render-controls-group" class="control-group">
          <summary>Render Style</summary>
          <div class="controls control-group-body">
            <label for="atom-size-slider">Atom Size</label>
            <input id="atom-size-slider" type="range" min="0.2" max="3.0" step="0.1" value="1" />
            <span id="atom-size-label">1.0x</span>

            <label for="bond-radius-slider">Bond Radius</label>
            <input id="bond-radius-slider" type="range" min="0.2" max="3.0" step="0.1" value="1" />
            <span id="bond-radius-label">1.0x</span>

            <div class="atom-style-controls">
              <label for="atom-style-range-input">Atom Indices (0-based)</label>
              <input
                id="atom-style-range-input"
                type="text"
                placeholder="e.g. 0-14, 20, 25-"
                autocomplete="off"
                spellcheck="false"
              />

              <label for="atom-style-mode-select">Mode</label>
              <select id="atom-style-mode-select">
                <option value="sphere">Sphere</option>
                <option value="stick">Stick</option>
                <option value="line">Line</option>
                <option value="cartoon">Cartoon</option>
              </select>

              <button id="atom-style-add-btn" type="button">Add Rule</button>
              <button id="atom-style-clear-btn" type="button">Clear Rules</button>

              <span id="atom-style-rules-hint" class="bond-selection-info">
                Rule format: 0-based N, A-B, or A- (to last atom); later rules override earlier ones.
              </span>
              <div id="atom-style-rules" class="atom-style-rules">
                <div class="atom-style-rule-empty">No per-atom style rules. Using default style.</div>
              </div>
            </div>
          </div>
        </details>

        <details id="nac-controls-group" class="control-group">
          <summary>NAC Vectors</summary>
          <div class="controls control-group-body">
            <label class="check-label" for="show-nac-vectors">
              <input id="show-nac-vectors" type="checkbox" />
              Show NAC Vectors
            </label>

            <label for="nac-state-i">State i</label>
            <select id="nac-state-i"></select>

            <label for="nac-state-j">State j</label>
            <select id="nac-state-j"></select>

            <label for="nac-scale-slider">Scale</label>
            <input id="nac-scale-slider" type="range" min="0.1" max="10" step="0.1" value="1" />
            <span id="nac-scale-label">1.0x</span>
            <span class="bond-selection-info" id="nac-range-label">|NAC|: n/a</span>

            <label class="check-label" for="show-de-vectors">
              <input id="show-de-vectors" type="checkbox" />
              Show dE Vectors
            </label>

            <div class="de-pair-actions">
              <label>dE State Pairs</label>
              <button id="add-de-pair-btn" type="button" aria-label="Add dE state pair">+ Add Pair</button>
            </div>
            <div id="de-pair-rows" class="de-pair-rows"></div>
            <template id="de-pair-row-template">
              <div class="de-pair-row" data-de-row-id="">
                <span class="de-row-swatch" aria-hidden="true"></span>
                <label class="check-label" title="Toggle this dE pair">
                  <input class="de-row-enabled" type="checkbox" checked />
                  On
                </label>
                <label class="de-row-label">i</label>
                <select class="de-row-state-i"></select>
                <label class="de-row-label">j</label>
                <select class="de-row-state-j"></select>
                <button class="de-row-remove-btn" type="button">Remove</button>
              </div>
            </template>
            <span id="de-visual-hint" class="bond-selection-info">Hue = pair, Brightness = |dE|</span>

            <label for="de-scale-slider">dE Scale</label>
            <input id="de-scale-slider" type="range" min="0.1" max="10" step="0.1" value="1" />
            <span id="de-scale-label">1.0x</span>
            <span class="bond-selection-info" id="de-range-label">|dE|: n/a</span>

            <label class="check-label" for="show-de-nac-vectors">
              <input id="show-de-nac-vectors" type="checkbox" />
              Show (E_j-E_i)*NAC Vectors
            </label>

            <label for="de-nac-scale-slider">dE*NAC Scale</label>
            <input id="de-nac-scale-slider" type="range" min="0.1" max="10" step="0.1" value="1" />
            <span id="de-nac-scale-label">1.0x</span>
            <span class="bond-selection-info" id="de-nac-range-label">|dE*NAC|: n/a</span>
          </div>
        </details>

        <details id="gif-range-controls-group" class="control-group">
          <summary>GIF Range</summary>
          <div class="controls control-group-body">
            <label for="gif-export-start">GIF Start</label>
            <input id="gif-export-start" type="number" min="0" step="1" value="0" />
            <label for="gif-export-end">GIF End</label>
            <input id="gif-export-end" type="number" min="0" step="1" value="0" />
            <button id="cancel-gif-export-btn" type="button" hidden disabled>Cancel Export</button>
            <span id="gif-export-progress"></span>
          </div>
        </details>
      </div>

      <div class="source-pkl" id="source-pkl">PKL: unknown</div>
    </div>

    <div class="viewer-card">
      <div id="viewer"></div>
      <div id="bond-list" class="bond-list"><div class="bond-list-empty">No bonds selected.</div></div>
      <div id="bond-plot"><div class="bond-plot-empty">Select Bond to show distance vs time.</div></div>
      <div class="status-row">
        <div id="status" class="status"></div>
        <button id="bond-color-settings-btn" class="status-tool-btn" type="button" disabled aria-expanded="false" title="Set tracked bond colors">⚙ Bond Colors</button>
      </div>
      <div id="bond-color-settings-panel" class="bond-color-settings-panel" hidden>
        <div class="bond-color-settings-head">
          <span id="bond-color-settings-title" class="bond-color-settings-title">Bond Color Settings</span>
          <button id="bond-color-settings-close-btn" class="bond-color-settings-close" type="button" aria-label="Close color settings">×</button>
        </div>
        <div id="bond-color-settings-list" class="bond-color-settings-list"><div class="bond-color-empty">No tracked bonds.</div></div>
      </div>
    </div>
  </div>

  <script id="bootstrap-json" type="application/json">{{ bootstrap_json | safe }}</script>
