<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Trajectory Observable Dashboard</title>
  <script src="assets/vendor/plotly-2.35.2.min.js?v={{ static_version }}"></script>
  <link rel="stylesheet" href="assets/dashboard/dashboard.css?v={{ static_version }}" />
</head>
<body>
  <div class="page">
    <div class="header">
      <div class="title">Trajectory Observable Dashboard</div>
      <div class="source-pkl" id="source-pkl">PKL: unknown</div>
      <div class="control-row">
        <div class="control-group">
          <label for="global-traj">Trajectory</label>
          <select id="global-traj"></select>
        </div>
        <div class="control-group">
          <label><input type="checkbox" id="global-ensemble" /> Show ensemble</label>
        </div>
        <div class="control-group">
          <label><input type="checkbox" id="global-traces" /> Show all traces in All mode</label>
        </div>
        <div class="control-group">
          <a class="mol3d-link" href="molecule3d.html" target="_blank" rel="noopener noreferrer">3D Molecule View</a>
        </div>
        <div class="control-group">
          <button class="btn" id="refresh-pkl-btn" type="button">Refresh PKL</button>
        </div>
      </div>

      <details id="traj-break-summary" class="break-summary">
        <summary>Trajectory Completion Summary</summary>
        <div class="break-summary-body">
          <div id="break-summary-status" class="break-summary-status"></div>
          <div id="break-summary-list" class="break-summary-list"></div>
        </div>
      </details>

      <details id="key-inspector" class="inspector">
        <summary>PKL Key Inspector</summary>
        <div class="inspector-body">
          <label for="key-inspector-input">Custom keys (one per line or comma-separated)</label>
          <textarea
            id="key-inspector-input"
            rows="5"
            placeholder="_.0.record.time
model.atoms
_.0.record.c"
          ></textarea>
          <div class="inspector-actions">
            <button class="btn" id="key-inspector-run" type="button">Inspect</button>
            <button class="btn" id="key-inspector-clear" type="button">Clear</button>
          </div>
          <div id="key-inspector-status" class="inspector-status"></div>
          <div id="key-inspector-results" class="inspector-results"></div>

          <div class="inspector-divider"></div>

          <label for="expr-inspector-input">Expression (supports tadd/tminus/tprod/tdiv/tneg/tinv/tabs/reduce)</label>
          <textarea
            id="expr-inspector-input"
            rows="4"
            placeholder="tadd{_.0.record.Etot,-5}
tdiv{_.0.record.Etot,_.0.record.A}
reduce{tabs{_.0.record.TWFpop},[-1]}"
          ></textarea>
          <label for="expr-inspector-label">Expression label (optional)</label>
          <input
            id="expr-inspector-label"
            type="text"
            placeholder="Etot minus 5"
          />
          <div class="inspector-actions">
            <button class="btn" id="expr-inspector-run" type="button">Run Expression</button>
            <button class="btn" id="expr-inspector-add" type="button">Add Expression Panel</button>
            <button class="btn" id="expr-inspector-clear" type="button">Clear</button>
          </div>
          <div id="expr-inspector-status" class="inspector-status"></div>
          <div id="expr-inspector-results" class="inspector-results"></div>
        </div>
      </details>

    </div>

    <div id="dashboard" class="dashboard"></div>

    <div class="footer-tools">
      <button class="btn primary" id="add-panel">Add Panel</button>
      <button class="btn" id="reset-panels">Reset to Default</button>
      <span class="status" id="panel-status"></span>
    </div>
  </div>

  <script id="bootstrap-json" type="application/json">{{ bootstrap_json | safe }}</script>
  <script src="assets/dashboard/dashboard_state.js?v={{ static_version }}"></script>
  <script src="assets/dashboard/dashboard_data_loader.js?v={{ static_version }}"></script>
  <script src="assets/math/dashboard_math3d.js?v={{ static_version }}"></script>
  <script src="assets/dashboard/dashboard_plot.js?v={{ static_version }}"></script>
  <script src="assets/dashboard/dashboard_ui.js?v={{ static_version }}"></script>
</body>
</html>
